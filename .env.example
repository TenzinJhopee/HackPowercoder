ELEVENLABS_API_KEY=
# Optional; defaults to ElevenLabs' Rachel voice.
ELEVENLABS_VOICE_ID=

# Claude for /api/director (server only)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Alternative: OpenRouter (takes precedence over Claude when set). Copy the exact model id from openrouter.ai.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
